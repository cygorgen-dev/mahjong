      [[SUIT.CHAR,1],[SUIT.CHAR,3],[SUIT.CHAR,5],
       [SUIT.BAMBOO,2],[SUIT.BAMBOO,4],[SUIT.BAMBOO,6],
       [SUIT.CIRCLE,7],[SUIT.CIRCLE,9],[SUIT.WIND,'North']
      ].forEach(([s,v]) => hand.push(mkTile(s,v)));
      discard = mkTile(SUIT.WIND, 'South');
      document.getElementById('inject-phase').value = 'claim';
      document.getElementById('discard-from').value = '2'; // TOP player
      document.getElementById('exp-kong').checked = false;
      document.getElementById('exp-pung').checked = false;
      document.getElementById('exp-win').checked = false;
      document.getElementById('exp-chow').checked = false;
      renderHand(); renderDiscard(); renderMelds();
      log('Preset loaded: unrelated tiles — all buttons should be disabled.', 'ok');
    }
  },
];

const presetList = document.getElementById('preset-list');
PRESETS.forEach((p, i) => {
  const btn = document.createElement('div');
  btn.className = 'preset-btn';
  btn.innerHTML = `<span class="ptitle">${p.title}</span><span class="pdesc">${p.desc}</span>`;
  btn.addEventListener('click', () => {
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    p.setup();
  });
  presetList.appendChild(btn);
});

// ============================================================
//  Auto-poll: watch for game's action log response
// ============================================================
setInterval(() => {
  try {
    const raw = localStorage.getItem('mahjongActionLog');
    if (!raw) return;
    const data = JSON.parse(raw);
    // Only show if fresh (within 10s)
    if (Date.now() - data.ts < 10000) {
      document.getElementById('result-area').style.display = 'block';
      const grid = document.getElementById('result-grid');
      const expWin  = document.getElementById('exp-win').checked;
      const expPung = document.getElementById('exp-pung').checked;
      const expKong = document.getElementById('exp-kong').checked;
      const expChow = document.getElementById('exp-chow').checked;
      const results = [
        { label:'Win',  actual:data.win,  expected:expWin  },
        { label:'Pung', actual:data.pung, expected:expPung },
        { label:'Kong', actual:data.kong, expected:expKong },
        { label:'Chow', actual:data.chow, expected:expChow },
      ];
      grid.innerHTML = '';
      for (const r of results) {
        const pass = r.actual === r.expected;
        const card = document.createElement('div');
        card.className = `result-card ${pass ? 'pass' : 'fail'}`;
        card.innerHTML = `<div class="label">${r.label}</div>
          <div class="value ${r.actual?'yes':'no'}">${r.actual?'ON':'OFF'}</div>
          <div style="font-size:10px;color:${pass?'#5dde7a':'#ff6666'};margin-top:2px;">${pass?'✓':'✗'}</div>`;
        grid.appendChild(card);
      }
    }
  } catch(e) {}
}, 1500);

// initial renders
renderMelds();
renderBonus();
buildBonusPalette();
</script>
</body>
</html>
